# This project does not require any secrets or API keys to run --
# everything runs locally against the bundled public dataset and
# locally-trained models. This file is provided for structural completeness
# (Section 25 of the brief) and future extension (e.g. if you later point
# the API at a managed Postgres instance instead of CSV files).

# Optional: override the port the FastAPI backend listens on when started
# via `uvicorn src.api.main:app` manually.
# API_PORT=8000

# Optional: override the port Streamlit listens on.
# STREAMLIT_PORT=8501
